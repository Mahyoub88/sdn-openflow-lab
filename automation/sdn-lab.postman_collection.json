        "method": "GET",
        "url": "{{ryu}}/stats/flow/3"
      }
    },
    {
      "name": "3 \u00b7 Clear s3 flow table",
      "request": {
        "method": "DELETE",
        "url": "{{ryu}}/stats/flowentry/clear/3"
      }
    },
    {
      "name": "4.1 \u00b7 Restore s3 entry (priority 100, 2054)",
      "request": {
        "method": "POST",
        "url": "{{ryu}}/stats/flowentry/add",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dpid\": 3,\n  \"table_id\": 0,\n  \"priority\": 100,\n  \"match\": {\n    \"eth_type\": 2054\n  },\n  \"actions\": [\n    {\n      \"type\": \"OUTPUT\",\n      \"port\": \"FLOOD\"\n    }\n  ]\n}"
        }
